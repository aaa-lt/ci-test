  "channels": [
    {
      "channel": 0,
      "role": "operator",
      "segments": [
        {
          "text": "компания кварта меня зовут анна здравствуйте чем могу помочь",
          "start": 0.96,
          "end": 5.37,
          "words": null
        },
        {
          "text": "понимаю ситуация неприятная давайте разберемся подскажите пожалуйста номер договора",
          "start": 16.86,
          "end": 23.16,
          "words": null
        },
        {
          "text": "спасибо и назовите пожалуйста фамилию имя и отчество владельца договора",
          "start": 30.21,
          "end": 35.58,
          "words": null
        },
        {
          "text": "сергей викторович спасибо вижу ваш договор",
          "start": 38.64,
          "end": 41.85,
          "words": null
        },
        {
          "text": "одну секунду открываю список услуг",
          "start": 42.45,
          "end": 44.97,
          "words": null
        },
        {
          "text": "так да у вас действительно подключен кинопакет плюс двести девяносто девять рублей в месяц подключение от двенадцатого июля",
          "start": 49.92,
          "end": 59.04,
          "words": null
        },
        {
          "text": "подключение было выполнено через приставку с пульта может быть кто то из домашних нажал",
          "start": 65.37,
          "end": 71.04,
          "words": null
        },
        {
          "text": "уведомление должно было прийти в личный кабинет но я вас услышала понимаю ваше возмущение",
          "start": 81.81,
          "end": 87.57,
          "words": null
        },
        {
          "text": "отключить услугу я могу прямо сейчас отключаю",
          "start": 95.49,
          "end": 98.88,
          "words": null
        },
        {
          "text": "готово кинопакет плюс отключен сегодняшнего дня больше списаний за него не будет",
          "start": 102.93,
          "end": 108.03,
          "words": null
        },
        {
          "text": "по возврату решение принимает финансовый отдел",
          "start": 110.61,
          "end": 113.73,
          "words": null
        },
        {
          "text": "я оформлю заявку на перерасчет ее рассмотрят",
          "start": 114.39,
          "end": 117.6,
          "words": null
        },
        {
          "text": "обычно в течение трех рабочих дней",
          "start": 120.57,
          "end": 122.64,
          "words": null
        },
        {
          "text": "если заявку одобрят да сумма за два месяца пятьсот девяносто восемь рублей вернется на лицевой счет",
          "start": 126.78,
          "end": 133.83,
          "words": null
        },
        {
          "text": "на карту возврат возможен только по письменному заявлению сейчас оформлю на лицевой счет так быстрее",
          "start": 137.76,
          "end": 144.03,
          "words": null
        },
        {
          "text": "я передам запрос в техническую службу чтобы проверили журнал действий приставки",
          "start": 150.84,
          "end": 155.49,
          "words": null
        },
        {
          "text": "как только будет ответ я вам перезвоню сегодня до шести вечера",
          "start": 156.21,
          "end": 160.44,
          "words": null
        },
        {
          "text": "да я лично перезвоню",
          "start": 167.16,
          "end": 168.57,
          "words": null
        },
        {
          "text": "номер для связи тот что указан в договоре заканчивается на сорок семь",
          "start": 169.17,
          "end": 174.09,
          "words": null
        },
        {
          "text": "хорошо номер вашей заявки на перерасчет два девять ноль пять один шесть запишите пожалуйста",
          "start": 176.1,
          "end": 182.79,
          "words": null
        },
        {
          "text": "я также зафиксировала ваше обращение в системе с описанием ситуации чтобы коллеги видели всю историю",
          "start": 187.98,
          "end": 194.58,
          "words": null
        },
        {
          "text": "сергей викторович могу я еще чем то помочь",
          "start": 197.16,
          "end": 199.98,
          "words": null
        },
        {
          "text": "тогда жду ответа от технической службы и перезвоню вам спасибо что обратились в квартал хорошего дня",
          "start": 202.17,
          "end": 208.86,
          "words": null
        }
      ],
      "windows": 1,
      "audio_seconds": 211.037
    },
    {
      "channel": 1,
      "role": "client",
      "segments": [
        {
          "text": "здравствуйте",
          "start": 6.03,
          "end": 6.66,
          "words": null
        },
        {
          "text": "я смотрю выписку по счету",
          "start": 7.32,
          "end": 8.76,
          "words": null
        },
        {
          "text": "и у меня уже второй месяц списывают деньги за какой то кинопакет плюс",
          "start": 9.42,
          "end": 14.19,
          "words": null
        },
        {
          "text": "я его не подключал",
          "start": 14.85,
          "end": 15.99,
          "words": null
        },
        {
          "text": "сейчас минутку четыре один семь семь ноль два пять",
          "start": 25.02,
          "end": 29.37,
          "words": null
        },
        {
          "text": "гаврилов сергей викторович",
          "start": 36.33,
          "end": 38.07,
          "words": null
        },
        {
          "text": "угу",
          "start": 45.06,
          "end": 45.27,
          "words": null
        },
        {
          "text": "двенадцатого июля",
          "start": 59.85,
          "end": 60.9,
          "words": null
        },
        {
          "text": "я в июле вообще в отпуске был",
          "start": 61.56,
          "end": 63.09,
          "words": null
        },
        {
          "text": "я ничего не подключал",
          "start": 63.72,
          "end": 64.86,
          "words": null
        },
        {
          "text": "нет дома никого не было я же говорю мы уезжали всей семьей",
          "start": 71.91,
          "end": 76.32,
          "words": null
        },
        {
          "text": "и почему мне никто ничего не сообщил ни смс ничего",
          "start": 77.01,
          "end": 81.06,
          "words": null
        },
        {
          "text": "в личный кабинет я не захожу",
          "start": 88.32,
          "end": 90.18,
          "words": null
        },
        {
          "text": "я хочу чтобы это отключили и вернули деньги за оба месяца",
          "start": 90.81,
          "end": 94.8,
          "words": null
        },
        {
          "text": "да отключайте",
          "start": 99.63,
          "end": 100.59,
          "words": null
        },
        {
          "text": "хорошо а деньги",
          "start": 108.69,
          "end": 109.92,
          "words": null
        },
        {
          "text": "и сколько ее будут рассматривать",
          "start": 118.26,
          "end": 119.94,
          "words": null
        },
        {
          "text": "то есть мне вернут пятьсот девяносто восемь рублей",
          "start": 123.27,
          "end": 126.06,
          "words": null
        },
        {
          "text": "на лицевой счет я бы хотел на карту",
          "start": 134.61,
          "end": 136.86,
          "words": null
        },
        {
          "text": "ну ладно пусть будет на счет но я хочу понять как вообще это подключилось без меня",
          "start": 144.69,
          "end": 150.15,
          "words": null
        },
        {
          "text": "угу",
          "start": 155.52,
          "end": 155.73,
          "words": null
        },
        {
          "text": "точно перезвоните а то я в прошлом году уже звонил по интернету и тоже обещали",
          "start": 161.04,
          "end": 166.5,
          "words": null
        },
        {
          "text": "да он",
          "start": 174.99,
          "end": 175.62,
          "words": null
        },
        {
          "text": "два девять ноль пять один шесть записал",
          "start": 184.23,
          "end": 187.2,
          "words": null
        },
        {
          "text": "ладно спасибо",
          "start": 195.39,
          "end": 196.5,
          "words": null
        },
        {
          "text": "нет это все",
          "start": 200.7,
          "end": 201.63,
          "words": null
        },
        {
          "text": "до свидания",
          "start": 209.34,
