  "utterances": [
    {
      "role": "operator",
      "text": "Компания «Кварта», меня зовут Виктория, здравствуйте.",
      "entities": [
        {
          "text": "Виктория",
          "type": "name"
        }
      ],
      "start": 0.8,
      "end": 4.294
    },
    {
      "role": "client",
      "text": "Здравствуйте. Я переезжаю и хочу перенести интернет на новый адрес.",
      "entities": [],
      "start": 4.749,
      "end": 9.739
    },
    {
      "role": "operator",
      "text": "Хорошо, давайте оформим перенос. Назовите, пожалуйста, номер договора и ваши фамилию, имя, отчество.",
      "entities": [],
      "start": 10.27,
      "end": 18.283
    },
    {
      "role": "client",
      "text": "Договор семь два ноль ноль пять пять восемь, Исмаилов Тимур Рашидович.",
      "entities": [
        {
          "text": "семь два ноль ноль пять пять восемь",
          "type": "number"
        },
        {
          "text": "Исмаилов Тимур Рашидович",
          "type": "name"
        }
      ],
      "start": 18.78,
      "end": 24.565
    },
    {
      "role": "operator",
      "text": "Спасибо, Тимур Рашидович. Назовите новый адрес.",
      "entities": [
        {
          "text": "Тимур Рашидович",
          "type": "name"
        }
      ],
      "start": 24.908,
      "end": 28.5
    },
    {
      "role": "client",
      "text": "Улица Сурганова, дом сорок три, корпус два, квартира сто семнадцать.",
      "entities": [
        {
          "text": "Сурганова",
          "type": "name"
        },
        {
          "text": "сорок три",
          "type": "number"
        },
        {
          "text": "два",
          "type": "number"
        },
        {
          "text": "сто семнадцать",
          "type": "number"
        }
      ],
      "start": 28.864,
      "end": 33.848
    },
    {
      "role": "operator",
      "text": "Проверяю техническую возможность. Одну минуту.",
      "entities": [],
      "start": 34.373,
      "end": 37.51
    },
    {
      "role": "client",
      "text": "Да, жду.",
      "entities": [],
      "start": 41.51,
      "end": 42.625
    },
    {
      "role": "operator",
      "text": "Дом подключён по технологии джипон, это оптоволокно до квартиры. Подключение возможно. Нужно будет заменить ваш роутер на оптический терминал, мастер привезёт его сам.",
      "entities": [
        {
          "text": "джипон",
          "type": "term"
        },
        {
          "text": "оптический терминал",
          "type": "term"
        }
      ],
      "start": 42.906,
      "end": 54.471
    },
    {
      "role": "client",
      "text": "Терминал платный?",
      "entities": [],
      "start": 54.981,
      "end": 56.138
    },
    {
      "role": "operator",
      "text": "Терминал выдаётся в аренду за девять рублей в месяц, либо можно выкупить за сто восемьдесят рублей. Вручную настраивать подключение не понадобится, терминал настраивается автоматически.",
      "entities": [
        {
          "text": "девять рублей",
          "type": "sum"
        },
        {
          "text": "сто восемьдесят рублей",
          "type": "sum"
        },
        {
          "text": "терминал",
          "type": "term"
        }
      ],
      "start": 56.641,
      "end": 70.086
    },
    {
      "role": "client",
      "text": "Пусть будет аренда. Когда мастер сможет приехать?",
      "entities": [],
      "start": 70.497,
      "end": 73.692
    },
    {
      "role": "operator",
      "text": "Ближайшее свободное время: двадцать восьмого сентября с десяти до двух. Вас устроит?",
      "entities": [
        {
          "text": "двадцать восьмого сентября",
          "type": "date"
        },
        {
          "text": "десяти до двух",
          "type": "date"
        }
      ],
      "start": 74.057,
      "end": 79.512
    },
    {
      "role": "client",
      "text": "Да, подходит.",
      "entities": [],
      "start": 79.87,
      "end": 81.09
    },
    {
      "role": "operator",
      "text": "Записала. Перенос бесплатный, на старом адресе интернет будет работать до дня подключения на новом. Мастер позвонит за час до приезда.",
      "entities": [],
      "start": 81.441,
      "end": 91.159
    },
    {
      "role": "client",
      "text": "Отлично, спасибо.",
      "entities": [],
      "start": 91.564,
      "end": 93.222
    },
    {
      "role": "operator",
      "text": "Заявка на перенос оформлена, номер три один семь семь четыре. Что-нибудь ещё?",
      "entities": [
        {
          "text": "три один семь семь четыре",
          "type": "number"
        }
      ],
      "start": 93.643,
      "end": 99.088
    },
    {
      "role": "client",
      "text": "Нет, всё понятно.",
      "entities": [],
      "start": 99.523,
      "end": 101.042
    },
    {
      "role": "operator",
      "text": "Спасибо за обращение, Тимур Рашидович, хорошего дня.",
      "entities": [
        {
          "text": "Тимур Рашидович",
          "type": "name"
        }
      ],
      "start": 101.601,
      "end": 105.455
    }
  ]
}