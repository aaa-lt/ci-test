{
  "call": "rude-call",
  "sampleRate": 8000,
  "channels": [
    "operator",
    "client"
  ],
  "duration": 70.77,
  "voices": {
    "operator": {
      "voice": "omazh",
      "emotion": "evil"
    },
    "client": {
      "voice": "ermil",
      "emotion": null
    }
  },
  "utterances": [
    {
      "role": "operator",
      "text": "Слушаю.",
      "entities": [],
      "start": 0.8,
      "end": 1.76
    },
    {
      "role": "client",
      "text": "Здравствуйте. У меня третий день не работает интернет. Я уже дважды звонил, мне сказали, что приедет мастер, но никто не приехал.",
      "entities": [],
      "start": 2.101,
      "end": 10.641
    },
    {
      "role": "operator",
      "text": "Номер договора.",
      "entities": [],
      "start": 11.039,
      "end": 12.498
    },
    {
      "role": "client",
      "text": "Шесть шесть один ноль четыре девять три.",
      "entities": [
        {
          "text": "Шесть шесть один ноль четыре девять три",
          "type": "number"
        }
      ],
      "start": 12.871,
      "end": 16.312
    },
    {
      "role": "operator",
      "text": "Заявка на выезд мастера есть, от четырнадцатого сентября. Статус «в очереди».",
      "entities": [
        {
          "text": "четырнадцатого сентября",
          "type": "date"
        }
      ],
      "start": 19.312,
      "end": 25.798
    },
    {
      "role": "client",
      "text": "Третий день в очереди? Я работаю из дома, мне интернет нужен сегодня.",
      "entities": [],
      "start": 26.055,
      "end": 30.395
    },
    {
      "role": "operator",
      "text": "Мастера распределяет другой отдел, это не мои проблемы.",
      "entities": [],
      "start": 30.668,
      "end": 34.915
    },
    {
      "role": "client",
      "text": "Как это не ваши? Вы же компания, я вам плачу шестьсот пятьдесят рублей каждый месяц.",
      "entities": [
        {
          "text": "шестьсот пятьдесят рублей",
          "type": "sum"
        }
      ],
      "start": 35.308,
      "end": 40.711
    },
    {
      "role": "operator",
      "text": "Мужчина, я вам уже объяснила. Ждите звонка от мастера.",
      "entities": [],
      "start": 40.211,
      "end": 44.913
    },
    {
      "role": "client",
      "text": "А когда он позвонит? Можно хотя бы примерное время?",
      "entities": [],
      "start": 45.124,
      "end": 48.191
    },
    {
      "role": "operator",
      "text": "Не знаю. Обычно в течение трёх дней.",
      "entities": [
        {
          "text": "трёх дней",
          "type": "date"
        }
      ],
      "start": 48.573,
      "end": 51.828
    },
    {
      "role": "client",
      "text": "Три дня уже прошли. Можете хотя бы пометить заявку как срочную?",
      "entities": [],
      "start": 52.205,
      "end": 55.874
    },
    {
      "role": "operator",
      "text": "Поставила пометку.",
      "entities": [],
      "start": 57.874,
      "end": 59.351
    },
    {
      "role": "client",
      "text": "И сделайте, пожалуйста, перерасчёт за дни без интернета.",
      "entities": [],
      "start": 59.659,
      "end": 63.13
    },
    {
      "role": "operator",
      "text": "Перерасчёт делается после восстановления связи, по заявлению.",
      "entities": [],
      "start": 63.404,
      "end": 67.879
    },
    {
      "role": "client",
      "text": "Ладно. Спасибо и на этом.",
      "entities": [],
      "start": 68.147,
      "end": 69.97
    }
  ]
}