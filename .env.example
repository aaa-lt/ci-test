# Copy to .env and fill in. .env is ignored by git.

# Yandex Cloud: service account API key with roles ai.languageModels.user,
# ai.speechkit-tts.user, ai.speechkit-stt.user; folder that owns the account.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Hugging Face user access token (write scope: needed to create and update the
# private Space; also pays for Inference Providers out of monthly credits).
HF_TOKEN=
# Owner of the private Space that hosts asr-service, e.g. "username".
HF_SPACE_OWNER=

# asr-service in the Space (local engines), printed by `uv run tools/asr.py deploy`:
# https://<owner>-talkodex-asr.hf.space
ASR_URL=
# asr-service on this machine (cloud engine, e-mail cleanup)
ASR_LOCAL_URL=http://127.0.0.1:8000
